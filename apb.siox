module apb;

// AMBA APB4 (ARM IHI 0024): a two-phase bus. The Requester raises `psel`
// for the setup phase and `penable` for the access phase; the Completer
// finishes the access with `pready`. `A` is the address width and `D` the
// data width (8, 16 or 32); `pstrb` carries one bit per data byte.
//
// PCLK and PRESETn are global to the interface and stay ordinary ports of
// the endpoint entities. One `psel` per Completer: a decoder fans them out.

use std::bits::unsigned;

pub struct Apb<A: integer, D: integer> {
    pub paddr: unsigned[A],
    pub pprot: unsigned[3],
    pub psel: Bit,
    pub penable: Bit,
    pub pwrite: Bit,
    pub pwdata: unsigned[D],
    pub pstrb: unsigned[D / 8],
    pub pready: Bit,
    pub prdata: unsigned[D],
    pub pslverr: Bit
}

pub view Requester<A: integer, D: integer> for Apb<A, D> {
    paddr out, pprot out, psel out, penable out, pwrite out, pwdata out,
    pstrb out, pready in, prdata in, pslverr in
}

pub view Completer<A: integer, D: integer> for Apb<A, D> {
    paddr in, pprot in, psel in, penable in, pwrite in, pwdata in,
    pstrb in, pready out, prdata out, pslverr out
}

// One Requester to `N` Completers. Completer `i` owns the `2^REGION` bytes at
// `i << REGION`; an access past the last one completes at once with
// `pslverr`. APB holds the address for the whole transfer, so the decode is
// combinational and the interconnect adds no wait states.
pub entity Interconnect<A: integer, D: integer, N: integer, REGION: integer> {
    up: Apb<A, D> Completer,
    down: Apb<A, D>[N] Requester
}

impl<A: integer, D: integer, N: integer, REGION: integer> Interconnect<A, D, N, REGION> {
    let index: unsigned[A];
    index = up.paddr >> REGION;
    for i in 0..N - 1 {
        down[i].paddr = up.paddr;
        down[i].pprot = up.pprot;
        down[i].penable = up.penable;
        down[i].pwrite = up.pwrite;
        down[i].pwdata = up.pwdata;
        down[i].pstrb = up.pstrb;
        down[i].psel = if index == i { up.psel } else { '0' };
    }
    if index < N {
        up.pready = down[index].pready;
        up.prdata = down[index].prdata;
        up.pslverr = down[index].pslverr;
    } else {
        up.pready = '1';
        up.prdata = 0;
        up.pslverr = '1';
    }
}
